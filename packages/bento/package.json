    },
    "./card": {
      "import": "./dist/primitives/card/index.js",
      "types": "./dist/primitives/card/index.d.ts"
    },
    "./checkbox": {
      "import": "./dist/primitives/checkbox/index.js",
      "types": "./dist/primitives/checkbox/index.d.ts"
